# ---- Build time (public, safe to be in the bundle) ----
# Final site URL: used for canonical / Open Graph / sitemap. A value containing "asynk.in" = STAGING (noindex).
SITE_URL=https://treatresorts.com/
# Tracking: leave empty to load nothing
VITE_GTM_ID=
VITE_GA4_ID=
VITE_META_PIXEL_ID=
# Optional Cloudflare Turnstile (site key is public)
VITE_TURNSTILE_SITE_KEY=
# Where the form posts (default /api/enquiry.php)
VITE_ENQUIRY_ENDPOINT=/api/enquiry.php

# ---- Server side (NOT in this file in production: see api/config.sample.php on the server) ----
# ENQUIRY_TO_EMAIL, SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_SECURE, MAIL_FROM, TURNSTILE_SECRET
